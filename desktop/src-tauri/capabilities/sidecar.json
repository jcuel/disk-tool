{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "sidecar",
  "description": "Rust-only sidecar lifecycle (no webview window)",
  "windows": [],
  "permissions": [
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "disk-tool",
          "sidecar": true,
          "args": ["serve", "--no-open", "--port", "0", "--ready-stdout"]
        }
      ]
    },
    {
      "identifier": "shell:allow-kill",
      "allow": [
        {
          "name": "disk-tool",
          "sidecar": true
        }
      ]
    }
  ]
}
